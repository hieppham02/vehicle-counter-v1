  <property name="windowTitle">
   <string>Phần mềm giám sát giao thông</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QMainWindow,QWidget{background:#282A36;color:#F8F8F2;font-family:'Segoe UI';}
QPushButton{background:#44475A;color:white;border-radius:6px;padding:8px;font-weight:bold;font-size:12px;border:none;}
QPushButton:hover{background:#6272A4;}
QPushButton:disabled{background:#333545;color:#5a5d7a;}
QPushButton#btn_start{background:#8BE9FD;color:#282A36;}
QPushButton#btn_start:hover{background:#B0F0FF;}
QPushButton#btn_start:disabled{background:#333545;color:#5a5d7a;}
QPushButton#btn_stop{background:#FF5555;color:white;}
QPushButton#btn_stop:hover{background:#FF7070;}
QPushButton#btn_open_stats{background:#6272A4;color:white;}
QPushButton#btn_open_stats:hover{background:#8BE9FD;color:#282A36;}
QProgressBar{border:none;border-radius:5px;background:#383A4D;}
QProgressBar::chunk{background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #8BE9FD,stop:1 #50FA7B);border-radius:5px;}
QSlider::groove:horizontal{height:5px;background:#44475A;border-radius:3px;}
QSlider::handle:horizontal{width:13px;height:13px;margin:-4px 0;background:#8BE9FD;border-radius:6px;}
QSlider::sub-page:horizontal{background:#8BE9FD;border-radius:3px;}
QComboBox{background:#44475A;color:white;border-radius:5px;padding:4px 8px;font-size:11px;border:none;}
QComboBox::drop-down{border:none;}
QComboBox QAbstractItemView{background:#282A36;color:white;selection-background-color:#6272A4;}
QFrame#left_panel{background:#23243A;border-radius:10px;}
QFrame#card_chart_bar,QFrame#card_chart_pie,QFrame#card_chart_trend{background:#2F3142;border-radius:8px;border:1px solid #44475A;}
QFrame#card_car,QFrame#card_bus,QFrame#card_truck,QFrame#card_motorbike{background:#383A4D;border-radius:10px;}
QFrame#frame_controls{background:#2A2B3D;border-radius:10px;}
QFrame#ctrl_bar{background:#23243A;border-radius:6px;}
QFrame.sep{background:#44475A;}
   </string>
